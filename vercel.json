{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node src/build.js",
  "outputDirectory": ".",
  "framework": null,
  "installCommand": "echo 'Der Seitenbau braucht keine Pakete.'",
  "cleanUrls": false,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" }
      ]
    },
    {
      "source": "/assets/img/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/assets/files/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/assets/(css|js)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/(.*).html",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/blog/feed.xml",
      "headers": [{ "key": "Content-Type", "value": "application/rss+xml; charset=utf-8" }]
    },
    {
      "source": "/llms.txt",
      "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }]
    }
  ],
  "redirects": [
    { "source": "/cv", "destination": "/lebenslauf.html", "permanent": false },
    { "source": "/lebenslauf", "destination": "/lebenslauf.html", "permanent": false },
    { "source": "/impressum", "destination": "/impressum.html", "permanent": false },
    { "source": "/datenschutz", "destination": "/datenschutz.html", "permanent": false },
    { "source": "/feed", "destination": "/blog/feed.xml", "permanent": false },
    { "source": "/rss", "destination": "/blog/feed.xml", "permanent": false }
  ]
}
